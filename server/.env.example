# ---------------------------------------------------------------
# MPR JEWELLERY — environment variables
# Copy to server/.env and fill in. NEVER commit real .env files.
# ---------------------------------------------------------------

# Database — PostgreSQL / Supabase connection string.
# Leave empty for local development to use the embedded PostgreSQL (PGlite) in storage/pgdata.
DATABASE_URL=

# Supabase Storage (optional). When set, uploads go to this bucket instead of storage/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=mpr-media

# Auth — long random string (e.g. `openssl rand -hex 48`). Required in production.
JWT_SECRET=

# UPI details used on first start (editable later in Owner Portal → Settings)
UPI_ID=9030957387@axl
UPI_PHONE=9030957387

# First owner account — created ONCE at startup (password stored as bcrypt hash).
# Remove SEED_OWNER_PASSWORD from the environment after the first start.
SEED_OWNER_EMAIL=bhavyakthmadanambeti@gmail.com
SEED_OWNER_PASSWORD=

# Server
NODE_ENV=development
PORT=5000
# Comma-separated allowed browser origins when frontend and API are on different domains
CORS_ORIGINS=
# Seed demo products & collections on an empty database (true/false)
SEED_DEMO=true

# Optional live metal-rate provider (JSON: {"gold_24k":..,"gold_22k":..,"gold_18k":..,"silver":..,"source":".."})
RATES_API_URL=
RATES_API_KEY=

# Payment provider: manual_upi (default). Future gateways register in server/src/services/payments/.
PAYMENT_PROVIDER=manual_upi
