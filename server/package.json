{
  "name": "mpr-jewellery-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/database/schema.sql','dist/database/schema.sql')\"",
    "start": "node dist/index.js",
    "seed": "tsx src/database/seed.ts",
